{
  "_comment": "Seed matrix for cron-prospector.ts. Verticals × geos × query templates are flattened and rotated daily (day-of-year based), daily_query_cap queries per run. Extend metros/verticals freely — the rotation adapts. Boise and Meridian are HARD-EXCLUDED (saturated agency market); Nampa/Caldwell allowed per Matt 2026-07-09. Footprint: ID, eastern OR/WA, western MT/WY, northern UT (no SLC — saturated).",
  "daily_query_cap": 12,
  "daily_qualify_cap": 15,
  "daily_scout_cap": 3,
  "min_qualify_score": 60,
  "serp_rank_min": 11,
  "serp_rank_max": 50,
  "exclusions": {
    "_comment": "domains: exact registrable-domain blocklist (aggregators, franchises, orgs). domain_substrings: candidate domains containing these are skipped (Treasure Valley guard). tlds: never prospect these.",
    "domains": [
      "yelp.com", "angi.com", "thumbtack.com", "homeadvisor.com", "houzz.com",
      "porch.com", "bark.com", "expertise.com", "threebestrated.com",
      "yellowpages.com", "bbb.org", "mapquest.com", "manta.com", "foursquare.com",
      "facebook.com", "instagram.com", "linkedin.com", "nextdoor.com", "reddit.com",
      "wikipedia.org", "craigslist.org", "indeed.com", "ziprecruiter.com", "glassdoor.com",
      "google.com", "youtube.com", "amazon.com", "groupon.com",
      "rotorooter.com", "mrrooter.com", "benjaminfranklinplumbing.com", "aireserv.com",
      "onehourheatandair.com", "horizonservices.com", "arswaterheaters.com", "ars.com",
      "redcross.org", "heart.org", "nationalcprfoundation.com", "cprcertified.com",
      "indeed.org", "niche.com", "trade-schools.net", "vocationaltraining.org",
      "bestcolleges.com", "affordablecolleges.com", "collegefactual.com"
    ],
    "domain_substrings": ["boise", "meridian", "treasurevalley"],
    "tlds": [".gov", ".edu", ".mil", ".org"]
  },
  "verticals": [
